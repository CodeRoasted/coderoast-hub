# Enforce LF line endings across the entire repository
* text=auto eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.cmake text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf

# Explicitly binary files
*.o binary
*.a binary
*.so binary
*.exe binary
*.dll binary
*.ninja binary

# The published samples are stored exactly as the warehouse's Sample Release delivers them: never
# eol-normalized. It is the LAST line because the last matching line wins over the extension rules
# above. Without it the hub would strip CRLF from a verbatim upstream file on its way in, as the
# warehouse's own global rule did to 15 of the 16 LogHub `_2k` samples (measured 2026-10-01).
samples/** -text
